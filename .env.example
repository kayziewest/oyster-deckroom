# Required
ADMIN_PASSWORD=change-me
BASE_URL=https://deck.oysterskin.com
SESSION_SECRET=any-long-random-string

# Branding on the viewer
BRAND_NAME=Oyster
SENDER_NAME=Jude

# Email: verification codes + alerts (Resend, Postmark, Google Workspace SMTP all work)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=Jude at Oyster <jude@oysterskin.com>
NOTIFY_EMAIL=jude@oysterskin.com

# Optional
SLACK_WEBHOOK_URL=
DATA_DIR=./data
GEO_LOOKUP=on
